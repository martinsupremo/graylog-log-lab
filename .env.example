# Copy to .env and fill in real values before `docker compose up`.
# .env is git-ignored -- secrets never go in the repo.

# At least 16 random characters. Generate with:
#   pwgen -N 1 -s 96
GRAYLOG_PASSWORD_SECRET=<generate-your-own>

# SHA-256 hex digest of the password you want for the Graylog "admin" user.
# Generate with:
#   echo -n "your-admin-password" | sha256sum
GRAYLOG_ROOT_PASSWORD_SHA2=<generate-your-own>
